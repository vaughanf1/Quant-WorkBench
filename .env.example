# Optional. The app runs with no keys at all — market data (OpenBB/yfinance)
# and SEC EDGAR are keyless.

# Telegram alert delivery (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI strategy builder (natural language -> validated strategy file)
ANTHROPIC_API_KEY=

# SEC asks for a descriptive User-Agent with contact info
SEC_USER_AGENT=quant-workbench research you@example.com
